# Reading First AI Engine — configuration template.
#
# PLACEHOLDERS ONLY. Never commit a real credential.
#
# NOTE: this file is a template for your orchestrator's env injection. The service
# deliberately does NOT read a .env file, and will REFUSE TO START if one is present on
# disk — the legacy pipeline modules call load_dotenv() at import time in 11 places, so a
# stray .env can silently override injected secrets with no log line and no error.

# ─── Role and server ──────────────────────────────────────────────────────────
AI_ENGINE_ROLE=api                     # api | worker | reconciler
AI_ENGINE_PORT=9099                    # matches the V1 spec's AI_Engine_BASE_URL example
AI_ENGINE_LOG_LEVEL=INFO
AI_ENGINE_JSON_LOGS=true

# ─── Backend integration (REQ-CFG-01) ─────────────────────────────────────────
BACKEND_BASE_URL=https://backend.internal:6060
TOKEN_URL=https://keycloak.internal:9090/realms/reading-first/protocol/openid-connect/token
AI_ENGINE_CLIENT_ID=reading-first-ocr-engine
AI_ENGINE_CLIENT_SECRET=__REPLACE_ME__

# ─── Inbound token validation — BLOCKED ON Q-01 ───────────────────────────────
# The V1 spec never states how to validate the inbound {ai-engine-bearer-token}: no
# algorithm, no JWKS location, no expected audience, and no indication of which Keycloak
# client the Backend presents. Until the Backend team answers, AUTH_ENFORCE stays false
# and every boot logs a warning.
# Validation IS implemented (JWKS, RS256, azp allowlist, fails closed). It is off by
# default only because we do not know which Keycloak client the Backend presents. Turning
# it on is these two variables.
AUTH_ENFORCE=false
BACKEND_ALLOWED_CLIENT_IDS=            # required when AUTH_ENFORCE=true
JWKS_URL=                              # defaults to TOKEN_URL with /token -> /certs
JWT_ISSUER=                            # defaults to the realm URL derived from TOKEN_URL
JWT_AUDIENCE=                          # optional: client_credentials tokens rarely carry aud
JWT_ALGORITHMS=RS256                   # asymmetric only; HS256 is rejected at startup
JWT_CLOCK_LEEWAY_SECONDS=30

# ─── Security: SSRF control (REQUIRED before exposing the service) ────────────
# sourceDownloadUrl is caller-supplied and fetched server-side. An empty allowlist logs a
# warning and does not host-restrict requests, which is acceptable locally and not in
# production.
SOURCE_URL_ALLOWED_HOSTS=storage.internal,s3.eu-west-1.amazonaws.com
SOURCE_URL_REQUIRE_HTTPS=true
# Resolve the host and reject loopback/link-local/private/reserved addresses. Keep this
# TRUE. The API's allowlist checks the literal host string at accept time; the worker
# fetches later over real HTTP, so an allowlisted name that resolves to 169.254.169.254 --
# where cloud instance metadata lives -- is caught by nothing else. Set it false ONLY to
# point a worker at a fake Backend on loopback (see devtools/local_stack.sh); the API logs
# a warning at every boot when it is off.
SOURCE_URL_RESOLVE_AND_CHECK=true

# ─── Job store (durability) ───────────────────────────────────────────────────
# `sqlite` is the default and is restart-safe: the job ledger, the callback outbox and the
# provider budget all live in this one file. EVERY role must point at the SAME path — the
# API writes the job, the worker claims it, the reconciler enforces its deadline.
# `memory` loses every in-flight job on exit and logs a warning at boot; it is for
# throwaway runs only.
JOB_STORE=sqlite                       # sqlite | memory
JOB_STORE_PATH=/var/lib/ai-engine/jobs.db

# ─── Storage ──────────────────────────────────────────────────────────────────
SCRATCH_DIR=/var/tmp/ai-engine
MODEL_CACHE_DIR=/var/cache/ai-engine/models   # MUST be persistent: 464 MB of weights
MAX_SOURCE_BYTES=209715200
MAX_SOURCE_PAGES=500

# ─── Concurrency, deadlines, retries ──────────────────────────────────────────
WORKER_JOB_CONCURRENCY=2
WORKER_PAGE_CONCURRENCY=4
JOB_PAGE_CONCURRENCY=4
WORKER_LEASE_SECONDS=300
PAGE_TASK_TIMEOUT_SECONDS=900
JOB_DEADLINE_SECONDS=86400
PAGE_MAX_ATTEMPTS=3
JOB_MAX_ATTEMPTS=3
CALLBACK_MAX_ATTEMPTS=10
RECONCILE_INTERVAL_SECONDS=60
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=60

# ─── Outbound retry policy (one layer owns retries; SDKs are set to 0) ────────
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=0.5           # exponential, with full jitter
RETRY_MAX_DELAY_SECONDS=60             # caps our backoff AND a hostile Retry-After
RETRY_TOTAL_BUDGET_SECONDS=120         # wall-clock ceiling across all attempts

# ─── Feature flags ────────────────────────────────────────────────────────────
DEFAULT_QUALITY_TIER=fast
ENABLE_VERIFIED_TIER=false             # kill-switch: verified is 65-200 paid calls/page
OCR_ENGINE=auto                        # auto prefers the free PDF text-layer path
TTS_ENGINE=gemini                      # gemini (paid) | synthetic (free, real WAV)
TTS_NARRATOR=female                    # V1 uploads exactly one Audio artifact
ALIGNMENT_ENGINE=whisper               # whisper (forced) | native (Hume timestamps)

# ─── Model configuration (was hardcoded constants in the legacy pipeline) ─────
OCR_GEMINI_MODEL=gemini-3.6-flash
TTS_GEMINI_MODEL=gemini-3.1-flash-tts-preview
TTS_GEMINI_VOICE=Kore
ALIGN_WHISPER_MODEL_SIZE=small
ALIGN_WHISPER_DEVICE=cpu               # no GPU is required anywhere in V1
ALIGN_WHISPER_COMPUTE_TYPE=int8
DIAC_THRESHOLD=0.15

# ─── Provider credentials ─────────────────────────────────────────────────────
# Absent keys are not a crash: the engine refuses at *selection* time, so a job fails once
# with MODEL_UNAVAILABLE instead of failing every page. OCR_ENGINE=auto needs no key at
# all for a book with a text layer — 25 of the 36 sample books qualify.
GEMINI_API_KEY=                        # required for OCR_ENGINE=gemini and TTS_ENGINE=gemini
LIGHTON_API_KEY=                       # required for OCR_ENGINE=lighton
LIGHTON_BASE_URL=https://api.lighton.ai

# ─── Fleet-wide provider budget (T-5.7) ───────────────────────────────────────
# `provider=calls/seconds`, comma-separated. Shared across every worker through the job
# store, so scaling workers does not scale the paid call rate.
#
# This is not a hypothetical safeguard. README.md:491 records a real free-tier ceiling of
# 10 requests/day per model, and a Hume quota that ran out mid-book left one book with 33
# page records and zero audio. A book averages 31.4 pages, so one book can exhaust one
# day's allowance.
#
# On exhaustion a page is PARKED, not failed: no callback is sent, the ledger row stays
# PENDING, and the job's lease is held until the window resets. `GET /ops/budget` shows
# what is left. Empty means unmetered — a wrong low value here silently parks real books,
# which is why there is no default.
PROVIDER_CALL_BUDGETS=                 # e.g. gemini=10/86400,hume=500/86400

# ─── Legacy pipeline location (adapters only) ─────────────────────────────────
# The directory CONTAINING `src/pipeline`. In the shipped image this is /app (the
# Dockerfile copies `src/` and `tools/` there); locally it is the repository root.
LEGACY_REPO_ROOT=/app

# ─── Deployment environment (spec 031) ─────────────────────────────────────────
# dev (default) | staging | production. `production` refuses to start until all of these
# are set safely -- the error lists every one still missing:
#   AUTH_ENFORCE=true + BACKEND_ALLOWED_CLIENT_IDS   (needs the Q-01 answer)
#   SOURCE_URL_ALLOWED_HOSTS=<storage host>          SOURCE_URL_RESOLVE_AND_CHECK=true
#   JOB_STORE=sqlite (not memory)                    PROVIDER_CALL_BUDGETS=gemini=.../86400
#   BACKEND_BASE_URL / TOKEN_URL not on localhost
ENVIRONMENT=dev
