# ------------------------------------------------------------------
# LightOn OCR
# Base URL defaults to a LOCAL server (http://localhost:8000/v1) if unset.
# Point it at your LightOn inference endpoint (self-hosted or cloud).
# ------------------------------------------------------------------
LIGHTON_API_KEY=
LIGHTON_BASE_URL=http://localhost:8000/v1

# ------------------------------------------------------------------
# Context Reviewer (ContextReviewer) - used inside OCR verification.
# REVIEWER_MODEL has NO default; ContextReviewer() raises immediately
# without it. REVIEWER_BASE_URL also defaults to localhost if unset.
# ------------------------------------------------------------------
REVIEWER_API_KEY=
REVIEWER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REVIEWER_MODEL=gemini-3.1-flash-preview

# ------------------------------------------------------------------
# Final text-only reviewer (FinalContextReviewer) - optional stage,
# off by default in run_full_pipeline.py. Falls back to REVIEWER_API_KEY
# / REVIEWER_BASE_URL if left empty.
# ------------------------------------------------------------------
FINAL_REVIEWER_API_KEY=
FINAL_REVIEWER_BASE_URL=
FINAL_REVIEWER_MODEL=gemini-3.1-pro-preview

# ------------------------------------------------------------------
# Gemini TTS. Falls back to REVIEWER_API_KEY if left empty.
# ------------------------------------------------------------------
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FEMALE_VOICE=Leda
GEMINI_TTS_MALE_VOICE=Orus

# ------------------------------------------------------------------
# Backend <-> AI Engine contract (per the integration doc).
# BACKEND_BASE_URL / TOKEN_URL / AI_ENGINE_CLIENT_SECRET are REQUIRED
# for POST /api/jobs to actually reach the backend once it's live.
# ------------------------------------------------------------------
BACKEND_BASE_URL=https://localhost:6060
TOKEN_URL=http://localhost:9090/realms/reading-first/protocol/openid-connect/token
AI_ENGINE_CLIENT_ID=reading-first-ocr-engine
AI_ENGINE_CLIENT_SECRET=

# Only override these if the backend's tokens come from a different
# realm/gateway than TOKEN_URL implies.
AI_ENGINE_JWT_ISSUER=
AI_ENGINE_JWT_AUDIENCE=

# DEV ONLY: skips Bearer-token validation on POST /api/jobs so it can be
# exercised before a real Keycloak/backend exists. Leave false/unset once
# real infra is available -- validation is ON by default.
AI_ENGINE_AUTH_DISABLED=true

# Not present in the job payload per the spec; used as a fallback until
# the backend team confirms how narrator/voice selection is passed.
AI_ENGINE_DEFAULT_NARRATOR=female
